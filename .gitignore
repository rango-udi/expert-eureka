# Local governance, release history and runtime state.
.local/
.runtime/
updates/
/evidence/
.env*
!apps/*/.env.template
apps/*/.runtime/
apps/*/reports/*
!apps/*/reports/.gitkeep
apps/*/backups/*
!apps/*/backups/.gitkeep
apps/*/evidence/*
!apps/*/evidence/.gitkeep
apps/*/upstream/*
!apps/*/upstream/.gitkeep

# Dependencies, build products and language/tool caches.
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
*.egg-info/
build/
dist/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Generated logs, archives, local databases and editor/OS files.
*.log
*.zip
*.sqlite3
*.sqlite3-*
*.db-journal
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
~$*.xlsx
~$*.xlsm
