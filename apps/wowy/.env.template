# Private Wowy fixture configuration, generated from this template by env init.
# Django signing secret. Blank generates a value once; preserve it with existing data.
SECRET_KEY=
# Administrator email for a new fixture account; must differ from the other roles.
ADMIN_EMAIL=avery@fuzcake.test
# Initial administrator password. Blank generates a secret; existing accounts are preserved.
ADMIN_PASSWORD=
# Customer fixture email; the same value is used as the login username.
CUSTOMER_EMAIL=mira@fuzcake.test
# Initial customer password. Blank generates a secret; editing this does not reset an account.
CUSTOMER_PASSWORD=
# Shop staff email; this role has limited dashboard access, not superuser rights.
STAFF_EMAIL=rowan@fuzcake.test
# Initial staff password. Blank generates a secret; keep it with database backups.
STAFF_PASSWORD=
# Waitress request threads, 1..16; 1 serves sequential browser tests.
WEB_THREADS=1
# Web/tools RAM ceiling; Docker size syntax. Blank uses 512m; 0 removes the ceiling.
APP_MEMORY_LIMIT=512m
# Browser RAM ceiling; blank uses the Compose default, 0 removes it.
ROBOT_MEMORY_LIMIT=1024m
# IANA time zone used by the application, for example Asia/Bangkok.
TIMEZONE=Asia/Bangkok
