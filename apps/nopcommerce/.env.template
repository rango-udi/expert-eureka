# Stable loopback port; retain it after native installation.
HTTP_PORT=8084
# Native web process RAM ceiling; not a measured minimum.
APP_MEMORY_LIMIT=1024m
# Private database RAM ceiling; no database port is published.
DB_MEMORY_LIMIT=256m
# Optional Chromium process RAM ceiling.
ROBOT_MEMORY_LIMIT=1024m
# Private database password; blank generates a value exactly once.
DB_PASSWORD=
# MariaDB root secret; not used by PostgreSQL.
DB_ROOT_PASSWORD=
# Initial native administrator email; preserve it with installed data.
ADMIN_EMAIL=avery@fuzcake.test
# Initial administrator secret; editing it never resets existing native accounts.
ADMIN_PASSWORD=
# Initial fictional customer email; nopCommerce currently seeds its catalogue only.
CUSTOMER_EMAIL=mira@fuzcake.test
# Initial fictional customer secret; existing accounts are preserved.
CUSTOMER_PASSWORD=
