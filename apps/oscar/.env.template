# Private application settings. Run cmdc env init --app oscar.
# Preserve generated credentials together with database/media backups.

# Django signing key. Blank generates a private random value on first initialization.
SECRET_KEY=

# Administrator login email. Must differ from customer and seller emails.
ADMIN_EMAIL=avery@fuzcake.test

# Initial administrator password. Blank generates a secret; existing accounts keep their password.
ADMIN_PASSWORD=

# Customer fixture login email used by the browser journeys.
CUSTOMER_EMAIL=mira@fuzcake.test

# Initial customer password. Blank generates a secret; retain the generated value for existing data.
CUSTOMER_PASSWORD=

# Partner-scoped seller login email; this account is not a superuser.
SELLER_EMAIL=rowan@fuzcake.test

# Initial seller password. Blank generates a secret; changing this file does not reset an existing account.
SELLER_PASSWORD=

# Waitress request threads, 1..16. Default 1 serves sequential test traffic.
WEB_THREADS=1

# Container RAM ceiling for web/tools. Docker size such as 384m; blank uses the Compose default; 0 removes the ceiling.
APP_MEMORY_LIMIT=384m

# Browser container RAM ceiling. Docker size such as 1024m; 0 explicitly removes the ceiling.
ROBOT_MEMORY_LIMIT=1024m

# IANA time zone for stored/displayed timestamps, for example Asia/Bangkok.
TIMEZONE=Asia/Bangkok
