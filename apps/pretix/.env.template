# Private application settings. Run cmdc env init --app pretix.
# Preserve generated credentials together with database/media backups.

# Application image tag. The digest override in compose.lock.yaml determines the installed image.
PRETIX_IMAGE=pretix/standalone:2026.9.2

# Lightweight HTTP gateway image tag; digest is pinned in compose.lock.yaml.
NGINX_IMAGE=nginx:1.27.3-alpine

# PostgreSQL image tag; keep the major version compatible with existing database volumes.
POSTGRES_IMAGE=postgres:16.6-alpine

# Redis image tag for cache, sessions and task transport; digest is pinned separately.
REDIS_IMAGE=redis:7.4.1-alpine

# Test mail inbox image tag; messages remain inside the local test environment.
MAILPIT_IMAGE=axllent/mailpit:v1.21.8

# Robot Framework Browser image tag, prepared only for browser commands.
ROBOT_IMAGE=marketsquare/robotframework-browser:21.0.0

# Git helper image tag, pulled only by the explicit source command.
GIT_IMAGE=alpine/git:2.47.2

# Standard-library helper image tag for configuration and local unit checks.
PYTHON_IMAGE=python:3.12.8-alpine

# Inclusive loopback host port range. Both endpoints must be within 49152..65535.
PUBLIC_PORT_RANGE=49152-65535

# Browser host name. Keep pretix.localhost aligned with the resolver rule in the smoke suite.
PRETIX_PUBLIC_HOST=pretix.localhost

# Docker-assigned gateway port. Leave blank in the template; the adapter records the actual port.
PRETIX_PUBLIC_PORT=

# Docker-assigned mail inbox port. Leave blank in the template; the adapter refreshes it.
MAILPIT_PUBLIC_PORT=

# Database credential. Blank generates a secret for a new environment; keep it with existing data.
POSTGRES_PASSWORD=

# Initial administrator credential. Blank generates a secret; existing accounts are not reset by seed.
ADMIN_PASSWORD=

# Initial organizer staff credential. Blank generates a secret; preserve it for later logins.
STAFF_PASSWORD=

# Administrator fixture email. Must differ from STAFF_EMAIL.
ADMIN_EMAIL=avery@fuzcake.test

# Organizer-scoped staff fixture email. This identity receives the seeded team permissions.
STAFF_EMAIL=rowan@fuzcake.test

# Human-readable instance name shown by the pretix application.
INSTANCE_NAME=Pretix Robot

# Default language code for the instance, for example en.
DEFAULT_LOCALE=en

# IANA time zone for the instance and seeded event dates.
TIMEZONE=Asia/Bangkok

# ISO currency code for seeded events, for example EUR.
CURRENCY=EUR

# single enforces sequential workers; custom uses the adjustable settings below.
EXECUTION_MODE=single

# Sum of per-container RAM allocations in MiB. Blank explicitly disables project ceilings; it does not configure the VM.
MEMORY_BUDGET_MIB=1920

# Web worker processes used in custom mode. single mode enforces 1.
WEB_WORKERS=1

# Web request threads used in custom mode. single mode enforces 1.
WEB_THREADS=1

# Celery pool used in custom mode. single mode selects solo.
TASK_POOL=prefork

# Concurrent Celery tasks in custom mode. single mode enforces 1.
TASK_CONCURRENCY=1

# Native math/image library threads in custom mode. single mode enforces 1.
NATIVE_THREADS=1

# Nginx worker processes in custom mode. single mode enforces 1 per proxy.
NGINX_WORKERS=1

# Nginx connections per worker in custom mode; this is not a count of test users.
NGINX_CONNECTIONS=128

# Browser shared-memory mount size in MiB; it remains within the container memory budget.
ROBOT_SHM_MIB=128

# manual keeps the scheduler stopped during ordinary start; scheduled enables recurring maintenance.
# Manual mode needs explicit manage runperiodic for maintenance-dependent journeys.
PERIODIC_TASKS=manual

# Restart policy after failure: no stops failed services; unless-stopped enables automatic retries.
RESTART_POLICY=no

# Extra disk-backed swap per finite container cap, in MiB. Default 0 disables container swap.
# Has no effect when MEMORY_BUDGET_MIB is empty; this does not change the VM swap setting.
CONTAINER_SWAP_ALLOWANCE_MIB=0

# Delay between periodic maintenance runs, in seconds. Allowed range: 60..3600.
PERIODIC_INTERVAL_SECONDS=300

# PostgreSQL shared buffer size in custom mode. single mode uses 32MB.
PG_SHARED_BUFFERS=64MB

# PostgreSQL memory per operation in custom mode. single mode uses 1MB; it is not a total database cap.
PG_WORK_MEM=2MB

# PostgreSQL maintenance memory in custom mode. single mode uses 16MB.
PG_MAINTENANCE_WORK_MEM=32MB

# PostgreSQL connection ceiling in custom mode. single mode uses 20.
PG_MAX_CONNECTIONS=40
