{
  "description": "Declared checkout-input model for initial fixture stock (25 units) and the configured manual payment choice. Update the model after stock changes; generated rows are not executed UI tests.",
  "fields": {
    "quantity": {
      "min": 1,
      "max": 25,
      "nominal": 2,
      "valid_representatives": [
        1,
        12,
        25
      ],
      "invalid_representatives": [
        0,
        26,
        "abc"
      ]
    },
    "payment_method": {
      "nominal": "fixture-payment",
      "valid_representatives": [
        "fixture-payment"
      ],
      "invalid_representatives": [
        "UNKNOWN"
      ]
    }
  },
  "decision_table": {
    "conditions": [
      "has_stock",
      "payment_method_available"
    ],
    "rules": [
      {
        "when": [
          true,
          true
        ],
        "expected": "allow_checkout"
      },
      {
        "when": [
          true,
          false
        ],
        "expected": "reject_payment_method"
      },
      {
        "when": [
          false,
          true
        ],
        "expected": "reject_stock"
      },
      {
        "when": [
          false,
          false
        ],
        "expected": "reject_stock_and_payment_method"
      }
    ]
  }
}
