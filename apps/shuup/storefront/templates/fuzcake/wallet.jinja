{% extends "shuup/front/base.jinja" %}
{% block title %}Your wallet{% endblock %}
{% block content %}<section class="fc-info">
<span class="eyebrow">YOUR EVERYDAY COMPANION</span>
<h1>fuzcake Wallet</h1>
<p>A clear view of your balance, funding methods and recent activity.</p>
<p class="local-note">Wallet credit is simulated. Adding funds does not charge a card. At checkout, choose a store payment method.</p>
<div class="wallet-overview">
<div>
<span>AVAILABLE BALANCE</span>
<strong>{{ "%.2f"|format(wallet_balance) }} {{ wallet_currency }}</strong>
<small>{{ request.user.get_full_name() or request.user.username }}</small>
</div>
<div>
<span>fuzcake</span>
<p>Keep a little possibility<br>in your pocket.</p>
</div>
</div>
{% if funding_methods %}<form method="post" class="wallet-form">{% csrf_token %}<input type="hidden" name="token" value="{{ funding_token }}">
<h2>Add to your wallet</h2>
<label for="funding-method">Funding method</label>
<select name="method" id="funding-method" class="selectpicker" data-width="100%" data-style="btn-default" required>{% for method in funding_methods %}<option value="{{ method.id }}">{{ method.name }}{% if method.last_four %} &middot; {{ method.last_four }}{% else %} &middot; {{ method.handle }}{% endif %}</option>{% endfor %}</select>
<label for="funding-amount">Amount in {{ wallet_currency }}</label>
<input name="amount" id="funding-amount" type="number" min="5" max="500" step="0.01" value="25.00" required>
<button class="fc-button" type="submit">Add to wallet<svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></button>
</form>{% endif %}
<h2>Recent activity</h2>
<div class="table-wrap">
<table class="ledger">
<thead>
<tr>
<th>Activity</th>
<th>Date</th>
<th>Status</th>
<th>Amount ({{ wallet_currency }})</th>
</tr>
</thead>
<tbody>{% for entry in wallet_entries %}{% set movement = entry.movement %}<tr>
<td>{{ movement.description }}<small>{{ movement.reference }}</small>
</td>
<td>{{ movement.occurred_at.strftime('%d %b %Y, %H:%M') }} UTC</td>
<td>
<span class="status-pill status-{{ movement.status }}">{{ movement.status|title }}</span>
</td>
<td>{{ "%+.2f"|format(entry.amount) }}</td>
</tr>{% else %}<tr>
<td colspan="4">Your activity will appear here.</td>
</tr>{% endfor %}</tbody>
</table>
</div>
{% if funding_methods %}<h2 style="margin-top:40px">Your cards</h2>
<div class="partner-grid">{% for method in funding_methods if method.kind == 'bank_card' %}{% for bank in fuzcake_partners.banks if bank.id == method.brand %}<article class="payment-card card-{{ bank.id }}">
<img src="{{ static(bank.logo) }}" alt="{{ bank.short_name }}">
<h3>{{ bank.name }}</h3>
<p>{{ method.name }}</p>
<strong>&bull;&bull;&bull;&bull; {{ method.last_four }}</strong>
<p>{{ method.holder }} &middot; {{ method.expiry }}</p>
</article>{% endfor %}{% endfor %}</div>{% endif %}
<a class="text-link" href="{{ url('fuzcake-partners') }}">Meet our payment partners<svg class="fc-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a>
</section>{% endblock %}
{% block extrajs %}{{ super() }}
<script>$(function () { $("#funding-method.selectpicker").selectpicker(); });</script>
{% endblock %}
