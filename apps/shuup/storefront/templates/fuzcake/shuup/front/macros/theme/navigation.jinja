{% macro render_menu_items() %}
<div class="fc-menu">
    <button class="toggle-mobile-nav" type="button" aria-label="Open store menu" data-toggle="tooltip" data-placement="bottom" title="Open store menu">
        <span class="sr-only">Menu</span><span class="hamburger" aria-hidden="true"></span>
    </button>
    <div class="pages">
        <ul class="nav-collapse">
            <li{% if request.path == '/' %} class="current"{% endif %}><a href="/">Home</a></li>
            {% set collection_url = url('shuup:all-categories') %}
            <li{% if request.path == collection_url %} class="current"{% endif %}><a href="{{ collection_url }}">The collection</a></li>
            <li{% if request.path == url('fuzcake-house') %} class="current"{% endif %}><a href="{{ url('fuzcake-house') }}">Our house</a></li>
            <li{% if request.path == url('fuzcake-wallet') %} class="current"{% endif %}><a href="{{ url('fuzcake-wallet') }}">Wallet</a></li>
            {% if shuup.simple_cms %}
                {% for link in xtheme.get_cms_navigation_links(request) %}
                    <li><a href="{{ link.url }}">{{ link.text }}</a></li>
                {% endfor %}
            {% endif %}
            {{ xtheme.render_menu_extensions(request) }}
        </ul>
    </div>
</div>
{% endmacro %}
